# SLiMS production. Salin: cp .env.example .env && chmod 600 .env
# Atau isi otomatis dari kredensial 04-mariadb-config.sh: sudo ./slims-prod.sh init-env

# --- Database (MariaDB di host, dibuat oleh deploy/server/04-mariadb-config.sh) ---
# IP gateway network slims-net = alamat host dari dalam container.
DB_HOST=192.168.121.33
DB_PORT=3306
DB_NAME=senayan
DB_USER=slims
# Dari /root/db-credentials.env (SLIMS_DB_PASS)
DB_PASS=
DB_WAIT_TIMEOUT=120

# --- Network (harus sama dengan rencana daemon.json & DB_BIND_ADDRS di server.env) ---
SLIMS_NETWORK=slims-net
SLIMS_SUBNET=192.168.121.32/27
SLIMS_GATEWAY=192.168.121.33
# Nama interface bridge di host (stabil, memudahkan firewall/fail2ban).
SLIMS_BRIDGE=br-slims
# IP otomatis untuk container lain hanya dari rentang ini (.49-.62), sehingga
# .33-.47 aman untuk IP tetap: SLiMS .35, WAF .34.
SLIMS_IP_RANGE=192.168.121.48/28
SLIMS_IP=192.168.121.35
# IP tetap container WAF di slims-net; hanya IP ini yang dipercaya untuk header IP klien.
TRUSTED_PROXY=192.168.121.34
TRUSTED_PROXY_HEADER=X-Forwarded-For

# --- Port uji di host (pengunjung lewat WAF, bukan port ini) ---
HTTP_BIND=127.0.0.1
HTTP_PORT=8881

# --- Resource container ---
SLIMS_CPUS=2
SLIMS_MEMORY=1g
SLIMS_MEMORY_RESERVATION=256m
SLIMS_PIDS=512
SLIMS_TMP_SIZE=256m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# --- Image ---
SLIMS_IMAGE=slims-bulian:prod
SLIMS_CONTAINER=slims-app
PHP_IMAGE=php:8.3.36-apache-bookworm@sha256:cbd3b3d9011668443d54ab40ec31db56c73d91b4c8198935d639aa80d2d815c1
