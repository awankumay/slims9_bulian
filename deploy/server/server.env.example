# Konfigurasi bersama untuk script setup server production (01-05).
# Salin dulu:  cp server.env.example server.env  &&  chmod 600 server.env
# lalu sesuaikan nilainya. Semua script membaca server.env dari folder ini.

# ---------------------------------------------------------------- akses admin
# Subnet VPN Tim Infrastruktur, pisahkan dengan spasi. WAJIB diisi.
# SSH (port 22) hanya dibuka untuk subnet ini, dan IP ini tidak pernah di-ban fail2ban.
ADMIN_CIDRS="10.8.0.0/24"

# User yang boleh login SSH, pisahkan dengan spasi. Setiap user wajib sudah punya
# ~/.ssh/authorized_keys; script 01 berhenti bila belum ada (mencegah terkunci).
SSH_ALLOW_USERS="infra"

# Grup yang boleh login SSH (AllowGroups), pisahkan dengan spasi. Cocok bila setiap
# anggota Tim Infra punya akun sendiri. Minimal salah satu dari SSH_ALLOW_USERS atau
# SSH_ALLOW_GROUPS wajib diisi. Bila keduanya diisi, sshd mewajibkan KEDUANYA: user
# harus ada di SSH_ALLOW_USERS dan menjadi anggota salah satu grup.
# AllowUsers/AllowGroups yang sudah ada di /etc/ssh/sshd_config tetap berlaku dan
# digabung; script 01 memeriksanya dan berhenti bila user yang login akan terkunci.
# Contoh hanya grup:  SSH_ALLOW_USERS=""  SSH_ALLOW_GROUPS="admin devops sshusers"
SSH_ALLOW_GROUPS=""

# Login root lewat SSH: "no" (disarankan) atau "prohibit-password" (root hanya dengan key).
SSH_PERMIT_ROOT="no"

# Zona waktu server (dipakai log, cron backup, fail2ban).
TIMEZONE="Asia/Jakarta"

# ------------------------------------------------------------------ web (WAF)
# Siapa yang boleh mengakses port 80/443 (container WAF):
#   vpn = hanya ADMIN_CIDRS + WEB_EXTRA_CIDRS (masa uji DNS lokal)
#   any = semua orang (setelah rilis publik). Ubah lalu jalankan ulang 02-firewall.sh.
WEB_ACCESS="vpn"
# Subnet tambahan yang boleh menguji web selama WEB_ACCESS=vpn (mis. LAN kantor).
WEB_EXTRA_CIDRS=""

# Interface jaringan publik VPS. Kosong = dideteksi dari default route.
EXT_IF=""

# --------------------------------------------------------------------- docker
# Segmen Docker dari daemon.json: bip 192.168.120.1/24 + pool 192.168.121.0/24.
DOCKER_CIDR="192.168.120.0/23"

# ------------------------------------------------------------------- mariadb
# innodb_buffer_pool_size, mis. "2G". Kosong = 40% RAM.
DB_BUFFER_POOL=""
# Host yang diizinkan untuk user aplikasi (alamat container di network Docker).
DB_APP_HOST="192.168.121.%"

EPRINTS_DB_NAME="eprints"
EPRINTS_DB_USER="eprints"
SLIMS_DB_NAME="senayan"
SLIMS_DB_USER="slims"

# Path install/senayan.sql dari repo slims9_bulian untuk memuat skema SLiMS ke
# database kosong. Kosongkan bila data akan di-restore dari staging.
SLIMS_SQL=""

# Backup harian (systemd timer) dengan mariadb-dump.
DB_BACKUP_DIR="/var/backups/mariadb"
DB_BACKUP_KEEP_DAYS="14"
DB_BACKUP_TIME="01:30"

# ------------------------------------------------------------------ fail2ban
# Folder log WAF di host (bind mount /var/log/waf pada container WAF).
WAF_LOG_DIR="/var/log/waf"
# UID:GID user nginx di image owasp/modsecurity-crs (nginx resmi = 101:101).
WAF_LOG_OWNER="101:101"
F2B_BANTIME="1h"
F2B_FINDTIME="10m"
