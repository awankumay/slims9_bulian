# SLiMS 9 Bulian - Docker Compose
# cp .env.example .env && chmod 600 .env, lalu isi password sebelum start pertama.

# --- Aplikasi ---------------------------------------------------------------
# production atau development (development menampilkan detail error)
APP_ENV=production
# 127.0.0.1 jika HTTPS ditangani reverse proxy / Cloudflare Tunnel
HTTP_BIND=0.0.0.0
HTTP_PORT=8881
# Detik maksimal menunggu DB sebelum container aplikasi berhenti dengan error
DB_WAIT_TIMEOUT=120

# --- Database ---------------------------------------------------------------
DB_NAME=senayan
# Akun DB aplikasi. Jangan root untuk instalasi baru
DB_USER=slims
DB_PASS=
# Password root MariaDB, hanya dipakai container db
DB_ROOT_PASS=
# Muat data sampel saat inisialisasi pertama (volume dbdata kosong)
LOAD_SAMPLE_DATA=false

# --- Image ------------------------------------------------------------------
# Uji PHP 8.4:
# PHP_IMAGE=php:8.4.27-apache-bookworm@sha256:e653ff90d7f6e2e6f81eddb07c864f1eae224ccbf5143f82a44f25e2f110e320
PHP_IMAGE=php:8.3.36-apache-bookworm@sha256:cbd3b3d9011668443d54ab40ec31db56c73d91b4c8198935d639aa80d2d815c1
SLIMS_IMAGE=slims-bulian:local
# Pin ke versi mayor untuk produksi, mis. mariadb:11.8
MARIADB_IMAGE=mariadb:lts

# --- Cloudflare Tunnel (opsional) -------------------------------------------
# Isi "tunnel" untuk menjalankan cloudflared bersama "docker compose up -d".
# Mematikan: docker compose rm -sf cloudflared, lalu kosongkan nilai ini.
COMPOSE_PROFILES=tunnel
# Token dari Zero Trust > Networks > Tunnels. Public Hostname service: http://slims:80
CLOUDFLARE_TUNNEL_TOKEN=
# Pin ke versi tertentu untuk produksi
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Ganti jika bentrok dengan jaringan lain. TUNNEL_PROXY_IP harus di dalam subnet
# dan bukan .1 (gateway); hanya IP ini yang dipercaya untuk CF-Connecting-IP.
TUNNEL_SUBNET=172.31.250.0/29
TUNNEL_PROXY_IP=172.31.250.6
