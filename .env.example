# Copy to .env and change every password before the first start.
# .env is excluded from git and from the Docker image.

# production | development
APP_ENV=production

# Host address and port for the web UI. Use 127.0.0.1 when a reverse proxy
# (Nginx, Caddy, Traefik) on the same host terminates HTTPS.
HTTP_BIND=0.0.0.0
HTTP_PORT=8881

# Application database account (not root).
DB_NAME=senayan
DB_USER=slims
DB_PASS=change-me-app-password

# MariaDB root password, used only by the database container.
DB_ROOT_PASS=change-me-root-password

# Load the demo collection on the first start (true/false).
LOAD_SAMPLE_DATA=false

# Optional overrides
# PHP_IMAGE=php:8.4.27-apache-bookworm@sha256:e653ff90d7f6e2e6f81eddb07c864f1eae224ccbf5143f82a44f25e2f110e320
# MARIADB_IMAGE=mariadb:lts
# SLIMS_IMAGE=slims-bulian:local
# DB_WAIT_TIMEOUT=120
